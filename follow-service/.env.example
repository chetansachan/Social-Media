# follow-service
DATABASE_URL=postgres://postgres:postgres@localhost:5432/social_media?sslmode=disable&x-migrations-table=follow_schema_migrations
DATABASE_READ_URL=
DB_MAX_CONNS=20
DB_MIN_CONNS=2
PORT=50053
ADMIN_PORT=9093

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

EVENT_STREAM=social:events
OUTBOX_POLL_INTERVAL=2s
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_STALE_AFTER=1m
OUTBOX_PRUNE_AFTER=168h
OUTBOX_RECLAIM_INTERVAL=1m
OUTBOX_BASE_BACKOFF=1s
OUTBOX_MAX_BACKOFF=5m

OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=0.1
