# syntax=docker/dockerfile:1.7
#
# Migration image: golang-migrate plus every service's migrations, laid out as
# one directory per database. Build from the repository root:
#
#   docker build -f deploy/docker/Dockerfile.migrate -t socialflow/migrate:dev .
#
# Each service owns a separate PostgreSQL database, so the directories are
# independent and can be applied in parallel. Comments run inside post-service's
# database, which is why there is no separate comments directory.
FROM migrate/migrate:v4.18.1

COPY backend/user-service/migrations /migrations/users
COPY backend/post-service/migrations /migrations/posts
COPY backend/follow-service/migrations /migrations/follows
COPY backend/notification-service/migrations /migrations/notifications
COPY backend/moderation-service/migrations /migrations/moderation
COPY backend/chat-service/migrations /migrations/chat

ENTRYPOINT ["/usr/local/bin/migrate"]
