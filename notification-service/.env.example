# Server
PORT=50055
WS_PORT=8085
# Internal admin port: /metrics, /healthz, /readyz.
ADMIN_PORT=9095
ENV=development

# OpenTelemetry. Leave the endpoint empty to propagate trace context without
# exporting spans.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLE_RATIO=0.1

# debug, info, warn, error
LOG_LEVEL=info

# PostgreSQL (system of record for inbox history)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/socialflow_notifications?sslmode=disable
# Optional replica (usually PgBouncer in front of the read replica). Empty
# means reads use DATABASE_URL.
DATABASE_READ_URL=
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# Redis (badge counters, dedup locks, aggregation, Pub/Sub)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Domain event ingestion (Redis Streams consumer group)
EVENT_CONSUMER_ENABLED=true
EVENT_STREAM=social:events
EVENT_GROUP=notification-service
EVENT_CONSUMER_NAME=notification-service-1
EVENT_CLAIM_INTERVAL=30s
EVENT_MAX_ATTEMPTS=5
EVENT_DLQ_STREAM=stream:notifications:dlq

# Upstream services (gRPC)
USER_SERVICE_ADDR=localhost:50051

# Aggregation, deduplication, and throttling
AGGREGATION_WINDOW=15m
DEDUP_TTL=60s
REALTIME_THROTTLE=30s
MAX_PUSH_PER_HOUR=5
PUSH_RATE_WINDOW=1h
UNREAD_CACHE_TTL=168h
RETENTION_DAYS=90

# WebSocket authentication
JWT_SECRET=
ALLOW_DEV_USER_ID=true
ALLOWED_ORIGINS=*

# Push provider: log | fcm | apns
PUSH_PROVIDER=log
FCM_CREDENTIALS_FILE=
FCM_PROJECT_ID=
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=com.socialflow.app
APNS_TOPIC=com.socialflow.app
APNS_SANDBOX=false

# Email provider: log | smtp
EMAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=notifications@socialflow.local

# Worker pools
WORKER_COUNT=8
QUEUE_SIZE=1024
