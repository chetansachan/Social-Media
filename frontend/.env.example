# frontend environment. Copy to .env and adjust.
# The Go API gateway must be running for live data; without it the app shows
# demo data and a banner explaining that.

# GraphQL endpoint served by the gateway. The dev server proxies /query to
# VITE_GRAPHQL_HTTP so the browser stays on one origin.
VITE_GRAPHQL_URL=/query
VITE_GRAPHQL_HTTP=http://localhost:8080

# "mock" renders demo data without contacting the gateway at all.
VITE_API_MODE=live
