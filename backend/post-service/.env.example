# post-service
DATABASE_URL=postgres://postgres:postgres@localhost:5432/social_media?sslmode=disable&x-migrations-table=post_schema_migrations
DATABASE_READ_URL=
DB_MAX_CONNS=20
DB_MIN_CONNS=2
PORT=50052
ADMIN_PORT=9092

# Only used to sign direct client uploads; the media bytes never reach this
# service. Leave it unset and the signature RPC returns FailedPrecondition.
CLOUDINARY_URL=

# Caps on media a caller hands to Upload, enforced on the decoded bytes. These
# mirror the composer's client-side limits so a direct API caller hits the same
# wall. A Cloudinary URL is not capped here: its size is only knowable after
# Cloudinary fetches it, which this service never does.
MEDIA_IMAGE_MAX_BYTES=10485760
MEDIA_VIDEO_MAX_BYTES=67108864

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Outbound event bus. The outbox rows commit with the write and the relay
# forwards them here; leaving it empty keeps the writes working and the feed
# stale.
EVENT_STREAM=social:events
OUTBOX_POLL_INTERVAL=2s
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_STALE_AFTER=1m
OUTBOX_PRUNE_AFTER=168h
OUTBOX_RECLAIM_INTERVAL=1m
OUTBOX_BASE_BACKOFF=1s
OUTBOX_MAX_BACKOFF=5m

# How long a post detail may be served from Redis before PostgreSQL is consulted.
POST_CACHE_TTL_SECONDS=300

OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=0.1
