# user-service
DATABASE_URL=postgres://postgres:postgres@localhost:5432/social_media?sslmode=disable&x-migrations-table=user_schema_migrations
DATABASE_READ_URL=
DB_MAX_CONNS=20
DB_MIN_CONNS=2
PORT=50051
ADMIN_PORT=9091

# Signs the access and refresh tokens. api-gateway and notification-service
# validate with the same key, so every service must read the same value.
MYSECRETKEY=replace-with-a-long-random-secret

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# How long a profile may be served from Redis before PostgreSQL is consulted.
USER_CACHE_TTL_SECONDS=600

OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=0.1
