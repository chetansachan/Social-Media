# API Gateway runtime configuration.
PORT=8080

# Internal admin port: /metrics, /healthz, /readyz.
ADMIN_PORT=9090

# Must match the key user-service signs access tokens with.
JWT_SECRET=change-me

USER_SERVICE_ADDR=localhost:50051
POST_SERVICE_ADDR=localhost:50052
FOLLOW_SERVICE_ADDR=localhost:50053
FEED_SERVICE_ADDR=localhost:50054
NOTIFICATION_SERVICE_ADDR=localhost:50055

# Number of HTTP/2 connections the gateway keeps open per backend. One
# connection bottlenecks around 15k QPS; four spreads stream limits and keeps a
# rolling restart from dropping every call.
GRPC_SUBCHANNELS=4

# Every backend RPC is bounded by this deadline. gRPC forwards it downstream,
# so a slow service cancels its own work instead of pinning a gateway worker.
GRPC_TIMEOUT=3s

# How long a tripped circuit breaker rejects calls before allowing one probe.
GRPC_BREAKER_TIMEOUT=10s

# GraphQL rate limits (sliding window per subject).
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_CREATE_POST_PER_MINUTE=10
RATE_LIMIT_FEED_PER_MINUTE=120
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=600
RATE_LIMIT_ANONYMOUS_PER_MINUTE=120

# Trust X-Forwarded-For / X-Real-IP. Enable only behind a proxy that
# overwrites those headers; otherwise anonymous clients can spoof their IP.
TRUST_PROXY_HEADERS=false

# Redis carries realtime notification frames to GraphQL subscriptions.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# OpenTelemetry. Leave the endpoint empty to propagate trace context without
# exporting spans.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLE_RATIO=0.1

# debug, info, warn, error
LOG_LEVEL=info
