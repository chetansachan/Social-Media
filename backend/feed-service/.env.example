PORT=50054
FOLLOW_SERVICE_ADDR=localhost:50053
POST_SERVICE_ADDR=localhost:50052

# Redis timeline cache
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Feed behaviour
TIMELINE_MAX_SIZE=800
TIMELINE_TTL_HOURS=720
CELEBRITY_THRESHOLD=25000
INACTIVE_THRESHOLD_DAYS=14

# Event ingestion (Redis Streams adapter)
EVENT_CONSUMER_ENABLED=true
EVENT_STREAM=social:events
EVENT_GROUP=feed-service
EVENT_CONSUMER_NAME=feed-service-1
