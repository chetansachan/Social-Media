# API Gateway runtime configuration.
PORT=8080

# Internal admin port: /metrics, /healthz, /readyz.
ADMIN_PORT=9090

# Must match the key user-service signs access tokens with.
JWT_SECRET=change-me

USER_SERVICE_ADDR=localhost:50051
POST_SERVICE_ADDR=localhost:50052
FOLLOW_SERVICE_ADDR=localhost:50053
FEED_SERVICE_ADDR=localhost:50054
NOTIFICATION_SERVICE_ADDR=localhost:50055

# Redis carries realtime notification frames to GraphQL subscriptions.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# OpenTelemetry. Leave the endpoint empty to propagate trace context without
# exporting spans.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLE_RATIO=0.1

# debug, info, warn, error
LOG_LEVEL=info
