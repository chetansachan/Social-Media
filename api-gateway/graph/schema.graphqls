type User {
    id: ID!
    username: String!
    name: String!
    email: String!
    isPublic: Boolean!
    createdAt: String!
    updatedAt: String!
}

type Query {
    getUserById(id: ID!): User
    getUserByEmail(email: String!): User
    getUserByUsername(username: String!): User
    tokenGenration(refressToken: String!): newTokens

}

type Mutation {
    register(input: RegisterUserInput!): User!
    Login(input: LoginInput): LoginResponse!
}

input RegisterUserInput {
    username: String!
    name: String!
    email: String!
    password: String!
    isPublic: Boolean
}

type LoginResponse {
    accessToken: String!
    refressToken: String!
    message: String!
}
input LoginInput {
    email: String!
    password: String!
}
type newTokens {
    accessToken: String!
    refressToken: String!
}