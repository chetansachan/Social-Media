type User {
    id: ID!
    username: String!
    name: String!
    email: String!
    isPublic: Boolean!
    createdAt: String!
    updatedAt: String!
}

type Query {
    user(id: ID!): User
}

type Mutation {
    register(input: RegisterUserInput!): User!
}

input RegisterUserInput {
    username: String!
    name: String!
    email: String!
    password: String!
    isPublic: Boolean
}