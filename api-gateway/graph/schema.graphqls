type User {
    id: ID!
    username: String!
    name: String!
    email: String!
    isPublic: Boolean!
    createdAt: String!
    updatedAt: String!
}

type Post {
    id: ID!
    authorId: String!
    content: String!
    mediaUrl: String!
    isPublic: Boolean!
    likeCount: Int!
    createdAt: String!
    updatedAt: String!
}

type Query {
    getUserById(id: ID!): User
    getPostById(id: ID!): Post
    getUserByEmail(email: String!): User
    getUserByUsername(username: String!): User
    tokenGenration(refressToken: String!): newTokens
    deleteUser(id: ID!): DeleteUserResponse

}

type Mutation {
    register(input: RegisterUserInput!): User!
    Login(input: LoginInput!): LoginResponse!
    UpdateUser(input: UpdateUserInput!): User!
    CreatePost(input: CreatePostInput!): Post!
    UpdatePost(input: UpdatePostInput!): Post!
}

input RegisterUserInput {
    username: String!
    name: String!
    email: String!
    password: String!
    isPublic: Boolean
}

type LoginResponse {
    accessToken: String!
    refressToken: String!
    message: String!
}

input LoginInput {
    email: String!
    password: String!
}

type newTokens {
    accessToken: String!
    refressToken: String!
}

input UpdateUserInput {
    id: String!
    username: String
    name: String
    email: String
    password: String
    isPublic: Boolean
}

type DeleteUserResponse {
    message: String!
}

input CreatePostInput {
    authorId: String!
    content: String!
    mediaUrl: String!
    isPublic: Boolean
}

input UpdatePostInput {
    id: String!
    authorId: String!
    content: String
    isPublic: Boolean
}