directive @auth on FIELD_DEFINITION

type User {
    id: ID!
    username: String!
    name: String!
    email: String!
    isPublic: Boolean!
    createdAt: String!
    updatedAt: String!
}

type Post {
    id: ID!
    authorId: String!
    content: String!
    mediaUrl: String!
    isPublic: Boolean!
    likeCount: Int!
    hasLiked: Boolean!
    createdAt: String!
    updatedAt: String!
    author: User!
}

type FeedPost {
    id: ID!
    authorId: String!
    content: String!
    mediaUrl: String!
    isPublic: Boolean!
    likeCount: Int!
    hasLiked: Boolean!
    createdAt: String!
    author: User!
}

# One node in a post's discussion tree. parentId is null for a top-level
# comment and depth is 0; replies increment depth up to the service's cap.
# author and hasLiked resolve through request-scoped dataloaders so a page of
# comments costs one user lookup and one like-state lookup, not two per node.
type Comment {
    id: ID!
    postId: ID!
    authorId: String!
    parentId: ID
    content: String!
    likeCount: Int!
    replyCount: Int!
    depth: Int!
    isDeleted: Boolean!
    hasLiked: Boolean!
    createdAt: String!
    updatedAt: String!
    author: User!
}

type CommentConnection {
    comments: [Comment!]!
    nextCursor: String
    hasMore: Boolean!
}

type FeedResponse {
    posts: [FeedPost!]!
    nextCursor: String
    hasMore: Boolean!
}

enum NotificationType {
    FOLLOW
    POST_LIKE
    COMMENT
    COMMENT_REPLY
    MENTION
    CREATOR_POST
    SYSTEM_ALERT
}

type NotificationActor {
    id: ID!
    username: String!
    displayName: String!
    avatarUrl: String!
}

type NotificationItem {
    id: ID!
    type: NotificationType!
    entityId: String!
    entityType: String!
    actors: [NotificationActor!]!
    totalActorsCount: Int!
    title: String!
    contentPreview: String
    actionUrl: String!
    isRead: Boolean!
    createdAt: String!
}

type NotificationResponse {
    notifications: [NotificationItem!]!
    nextCursor: String
    hasMore: Boolean!
    unreadCount: Int!
}

type NotificationSettings {
    inappLikes: Boolean!
    inappComments: Boolean!
    inappFollows: Boolean!
    inappMentions: Boolean!
    pushEnabled: Boolean!
    pushLikes: Boolean!
    pushComments: Boolean!
    pushFollows: Boolean!
    pushMentions: Boolean!
    emailEnabled: Boolean!
    emailWeeklyDigest: Boolean!
    emailSecurityAlerts: Boolean!
    quietHoursEnabled: Boolean!
    quietHoursStart: String!
    quietHoursEnd: String!
    timezone: String!
}

# Short-lived Cloudinary signature for a direct client upload. The API secret
# never leaves post-service; the client posts the file straight to uploadUrl.
type UploadSignature {
    cloudName: String!
    apiKey: String!
    # Unix epoch seconds, encoded as a string so the contract outlives 2038.
    timestamp: String!
    signature: String!
    folder: String!
    publicId: String!
    uploadUrl: String!
    expiresAt: String!
}

type Query {
    getUserById(id: ID!): User! @auth
    getUserByEmail(email: String!): User! @auth
    getUserByUsername(username: String!): User!
    tokenGenration(refressToken: String!): newTokens!
    deleteUser(id: ID!): DeleteUserResponse! @auth

    getPostById(id: ID!): Post!
    getArchivedPostById(id: ID!): Post! @auth
    getAllPost(author_id: String!): [Post!]!
    getAllArchivedPost(author_id: String!): [Post!]! @auth
    deletePost(id: ID!): DeletePostResponse! @auth
    moveToArchive(id: ID!): MovePostToArchivedResponse! @auth
    getAllPostLikers(post_id: String!): [String!]!
    getAllLikedPosts(user_id: String!): [Post!]! @auth
    getComment(id: ID!): Comment!
    # parentId selects one comment's replies; omit it for top-level comments.
    getComments(postId: ID!, parentId: ID, limit: Int, cursor: String): CommentConnection!

    getFollowers(userId: String!): [String!]!
    getFollowing(userId: String!): [String!]!
    getFollowCounts(userId: String!): FollowCountsResponse!
    getFollowStatus(followerId: String!, followingId: String!): FollowStatusResponse! @auth

    getFeed(limit: Int, cursor: String): FeedResponse! @auth
    getNotifications(limit: Int, cursor: String, filter: NotificationType): NotificationResponse! @auth
    getUnreadNotificationCount: Int! @auth
    getNotificationSettings: NotificationSettings! @auth
    getUploadSignature(resourceType: String, folder: String): UploadSignature! @auth
}

type Mutation {
    register(input: RegisterUserInput!): User!
    Login(input: LoginInput!): LoginResponse!
    UpdateUser(input: UpdateUserInput!): User! @auth
    CreatePost(input: CreatePostInput!): Post! @auth
    UpdatePost(input: UpdatePostInput!): Post! @auth
    likePost(input: LikePostInput!): LikePostResponse! @auth
    createComment(input: CreateCommentInput!): Comment! @auth
    updateComment(input: UpdateCommentInput!): Comment! @auth
    deleteComment(id: ID!): DeleteCommentResponse! @auth
    likeComment(input: LikeCommentInput!): LikeCommentResponse! @auth
    followUser(input: FollowUserInput!): FollowUserResponse! @auth
    unfollowUser(input: UnfollowUserInput!): UnfollowUserResponse! @auth
    removeFollower(input: RemoveFollowerInput!): RemoveFollowerResponse! @auth

    markNotificationAsRead(notificationIds: [ID!]!): Boolean! @auth
    markAllNotificationsAsRead: Boolean! @auth
    deleteNotification(id: ID!): Boolean! @auth
    updateNotificationSettings(input: UpdateNotificationSettingsInput!): NotificationSettings! @auth
    registerDeviceToken(token: String!, platform: String!, deviceName: String, appVersion: String): Boolean! @auth
    revokeDeviceToken(token: String!): Boolean! @auth
    # Blacklists the caller's current access token for its remaining lifetime.
    logout: Boolean! @auth
}

type Subscription {
    notificationReceived: NotificationItem! @auth
}

input RegisterUserInput {
    username: String!
    name: String!
    email: String!
    password: String!
    isPublic: Boolean
}

type LoginResponse {
    accessToken: String!
    refressToken: String!
    message: String!
}

input LoginInput {
    email: String!
    password: String!
}

type newTokens {
    accessToken: String!
    refressToken: String!
}

input UpdateUserInput {
    id: String!
    username: String
    name: String
    email: String
    password: String
    isPublic: Boolean
}

type DeleteUserResponse {
    message: String!
}

input CreatePostInput {
    authorId: String!
    content: String!
    mediaUrl: String!
    isPublic: Boolean
}

input UpdatePostInput {
    id: String!
    authorId: String!
    content: String
    isPublic: Boolean
}

type DeletePostResponse {
    message: String!
}

type MovePostToArchivedResponse {
    message: String!
}

input LikePostInput {
    postId: String!
    userId: String!
}

type LikePostResponse {
    isLiked: Boolean!
    message: String!
}

# The author is taken from the verified token, never from client input.
input CreateCommentInput {
    postId: ID!
    # Omit for a top-level comment; set to reply in a thread.
    parentId: ID
    content: String!
}

input UpdateCommentInput {
    id: ID!
    content: String!
}

input LikeCommentInput {
    commentId: ID!
}

type LikeCommentResponse {
    isLiked: Boolean!
    message: String!
}

type DeleteCommentResponse {
    message: String!
}

input FollowUserInput {
    followerId: String!
    followingId: String!
}

type FollowUserResponse {
    message: String!
}

input UnfollowUserInput {
    followerId: String!
    followingId: String!
}

type UnfollowUserResponse {
    message: String!
}

input RemoveFollowerInput {
    userId: String!
    followerId: String!
}

type RemoveFollowerResponse {
    message: String!
}

type FollowCountsResponse {
    followersCount: Int!
    followingCount: Int!
}

type FollowStatusResponse {
    isFollowing: Boolean!
}

input UpdateNotificationSettingsInput {
    inappLikes: Boolean
    inappComments: Boolean
    inappFollows: Boolean
    inappMentions: Boolean
    pushEnabled: Boolean
    pushLikes: Boolean
    pushComments: Boolean
    pushFollows: Boolean
    pushMentions: Boolean
    emailEnabled: Boolean
    emailWeeklyDigest: Boolean
    emailSecurityAlerts: Boolean
    quietHoursEnabled: Boolean
    quietHoursStart: String
    quietHoursEnd: String
    timezone: String
}
