type User {
    id: ID!
    username: String!
    name: String!
    email: String!
    isPublic: Boolean!
    createdAt: String!
    updatedAt: String!
}

type Post {
    id: ID!
    authorId: String!
    content: String!
    mediaUrl: String!
    isPublic: Boolean!
    likeCount: Int!
    createdAt: String!
    updatedAt: String!
}

type Query {
    getUserById(id: ID!): User!
    getUserByEmail(email: String!): User!
    getUserByUsername(username: String!): User!
    tokenGenration(refressToken: String!): newTokens!
    deleteUser(id: ID!): DeleteUserResponse!

    getPostById(id: ID!): Post!
    getArchivedPostById(id: ID!): Post!
    getAllPost(author_id: String!): [Post!]!
    getAllArchivedPost(author_id: String!): [Post!]!
    deletePost(id: ID!): DeletePostResponse!
    moveToArchive(id: ID!): MovePostToArchivedResponse!
    getAllPostLikers(post_id: String!): [String!]!
    getAllLikedPosts(user_id: String!): [Post!]!

    getFollowers(userId: String!): [String!]!
    getFollowing(userId: String!): [String!]!
    getFollowCounts(userId: String!): FollowCountsResponse!
    getFollowStatus(followerId: String!, followingId: String!): FollowStatusResponse!
}

type Mutation {
    register(input: RegisterUserInput!): User!
    Login(input: LoginInput!): LoginResponse!
    UpdateUser(input: UpdateUserInput!): User!
    CreatePost(input: CreatePostInput!): Post!
    UpdatePost(input: UpdatePostInput!): Post!
    likePost(input: LikePostInput!): LikePostResponse!
    followUser(input: FollowUserInput!): FollowUserResponse!
    unfollowUser(input: UnfollowUserInput!): UnfollowUserResponse!
    removeFollower(input: RemoveFollowerInput!): RemoveFollowerResponse!
}

input RegisterUserInput {
    username: String!
    name: String!
    email: String!
    password: String!
    isPublic: Boolean
}

type LoginResponse {
    accessToken: String!
    refressToken: String!
    message: String!
}

input LoginInput {
    email: String!
    password: String!
}

type newTokens {
    accessToken: String!
    refressToken: String!
}

input UpdateUserInput {
    id: String!
    username: String
    name: String
    email: String
    password: String
    isPublic: Boolean
}

type DeleteUserResponse {
    message: String!
}

input CreatePostInput {
    authorId: String!
    content: String!
    mediaUrl: String!
    isPublic: Boolean
}

input UpdatePostInput {
    id: String!
    authorId: String!
    content: String
    isPublic: Boolean
}

type DeletePostResponse {
    message: String!
}

type MovePostToArchivedResponse {
    message: String!
}

input LikePostInput {
    postId: String!
    userId: String!
}
type LikePostResponse {
    isLiked: Boolean!
    message: String!
}

input FollowUserInput {
    followerId: String!
    followingId: String!
}

type FollowUserResponse {
    message: String!
}

input UnfollowUserInput {
    followerId: String!
    followingId: String!
}

type UnfollowUserResponse {
    message: String!
}

input RemoveFollowerInput {
    userId: String!
    followerId: String!
}

type RemoveFollowerResponse {
    message: String!
}

type FollowCountsResponse {
    followersCount: Int!
    followingCount: Int!
}

type FollowStatusResponse {
    isFollowing: Boolean!
}